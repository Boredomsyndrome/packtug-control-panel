# Copy to .env and edit. Read by backend/webctl/config.py (SERVER side).
# Robot-side config lives in robot/robotctl.env.example instead.

# The fleet registry: robot_id:token pairs, comma-separated. The token is
# this robot's client secret (HTTP Basic password; username = robot id).
# Generate one per robot:  python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# An empty token ("myrobot:") disables robot auth — LAN-dev only!
WEBCTL_ROBOTS=s2000-1:change-me,s2000-2:change-me-too

# Safety clamps (m/s, rad/s). Remote driving must stay slow.
# Enforced twice: here at the command gate, and the robot client watchdog
# (WEBCTL_WATCHDOG) stops the robot if the link to THIS server dies.
MAX_LIN=0.5
MAX_ROT=0.7

# A held browser command older than this is replaced by ZERO at the next
# robot poll (browser stops driving -> robot stops within this window).
CMD_TIMEOUT=0.5

# Max accepted camera JPEG upload per frame (bytes).
MAX_FRAME=2097152

# Browser password REMOVED (v3.2): the page/API/ws are unauthenticated by
# design — access control is the network (run behind VPN/trusted LAN only).
# Robots under /robotctl/ keep their per-robot tokens regardless.

# --- Optional server-side knobs (defaults are fine; exact semantics in
# backend/webctl/config.py and backend/arm_server.py) ---
# WEBCTL_LOG_LEVEL, PACKTUG_DEBUG, ARM_HOST, WHEELTEC_WEBCTL_URL,
# QR_CODE_SIZE_M, ARM_MOTION_FAULT_ENABLED

# --- Frontend build-time keys (read by `npm run build` via Vite, NOT by
# the server) — put them in .env too; values below ARE the code defaults
# (src/services/endpoints.ts), so omitting them keeps the same behavior ---
# VITE_API_BASE=/api
# VITE_MOCK=true            # set 'false' to force the real backend

