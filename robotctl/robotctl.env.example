# /etc/wheeltec-robotctl.env — one per robot (systemd EnvironmentFile).
# Copy to /etc/wheeltec-robotctl.env and edit. This file is the ONLY thing
# the robot needs to know about the outside world.

# Control server (the Django box on the same WiFi). Plain http on a
# trusted LAN; https via reverse proxy if it ever crosses untrusted links.
WEBCTL_SERVER=http://192.168.1.50:8000

# This robot's identity — must match one entry of the server's
# WEBCTL_ROBOTS="robot_id:token,..." registry.
WEBCTL_ROBOT_ID=s2000-1
WEBCTL_ROBOT_TOKEN=change-me-per-robot

# Safety: no successful poll from the server for this many seconds ->
# publish zero velocity immediately (onboard watchdog; the LAST line of
# defense, the server never serves stale commands either).
WEBCTL_WATCHDOG=1.0

# Long-poll window per request (seconds). Command latency ~ this/2.
WEBCTL_POLL_WAIT=0.4

# Camera (OPTIONAL): local MJPEG source to relay to the server. This is
# web_video_server bound to LOOPBACK ONLY on this robot — the machine never
# listens on a network port; the client pulls 127.0.0.1 and pushes up.
WEBCTL_CAM_URL=http://127.0.0.1:8080/stream?topic=/camera/image_raw

# ROS topics (defaults match wheeltec ROS2 images)
WEBCTL_CMD_VEL_TOPIC=/cmd_vel
WEBCTL_BATTERY_TOPICS=/PowerVoltage,/power_voltage

# Leave unset on the robot (integration tests set it to skip rclpy):
# WEBCTL_DRY_RUN=1
# WEBCTL_SINK=/tmp/webctl-sink.json
