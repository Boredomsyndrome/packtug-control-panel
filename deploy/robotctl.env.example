# wheeltec-webctl robot client environment — copy to
# ~/.config/wheeltec-robotctl.env (chmod 600) OR keep it wherever
# run_client.sh is told to source it, e.g.:
#   bash ~/robotctl/run_client.sh /home/wheeltec/robotctl/robotctl.env
# (run_client.sh WITHOUT the path falls back to ~/.config/wheeltec-robotctl.env)

# v3.6: WEBCTL_SERVER may be a SPACE/COMMA-SEPARATED LIST of hub URLs.
# The client sticks to whichever endpoint is reachable and rotates to the
# next one on every link failure — pull the VPN cable, unplug the LAN, it
# self-heals within one retry window (no restart needed).
# Put the endpoint with the lowest latency FIRST (LAN beats VPN here).
WEBCTL_SERVER=http://192.168.1.142:8090 http://192.168.42.1:8090

# Robot identity (must match the hub registration)
WEBCTL_ROBOT_ID=s2000-1
WEBCTL_ROBOT_TOKEN=change…e-me

# Autonomy plane (needs robotctl/navd.py + navctl.sh next to client.py)
WEBCTL_NAV=1

# Everything else is optional; defaults documented at the top of client.py.
