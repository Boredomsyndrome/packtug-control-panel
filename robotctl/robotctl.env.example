# wheeltec-webctl ROBOT client env — per robot, ZERO INSTALL on the robot.
# Preferred location:  ~/.config/wheeltec-robotctl.env   (chmod 600)
# (run_client.sh loads it; /etc/wheeltec-robotctl.env also works if you
#  prefer the optional systemd unit — nothing else needs to be installed.)

# Control server = the Django laptop on the shared WiFi (its LAN IP, or
# http://10.42.0.1:8000 when the laptop runs its own hotspot). Plain http
# on a trusted LAN; the robot dials out, never the other way.
WEBCTL_SERVER=http://192.168.50.50:8000

# This robot's identity — must match one entry of the server registry
# WEBCTL_ROBOTS="robot_id:token,...". One robot today, ten tomorrow:
# just add registry lines server-side and copies of this file robot-side.
WEBCTL_ROBOT_ID=s2000-1
WEBCTL_ROBOT_TOKEN=change-me-per-robot

# Transport. v3.7 SINGLE-WEBSOCKET POLICY: the robot->server link is ONE
# websocket carrying EVERYTHING (cmd push, telemetry, camera frames, LiDAR
# scans, nav mailbox, map uploads). 'ws' = that and nothing else (deployed
# default; deploy_robot.py writes it). 'auto' additionally enables a
# degraded HTTP long-poll fallback used ONLY when no ws can connect at all
# — keep it for dev/experiments, never for the fleet.
WEBCTL_TRANSPORT=ws

# Safety: no server contact for this many seconds -> publish zero (onboard
# watchdog; the server independently never serves stale velocities either).
# The internal ws keep-alive ping is auto-clamped to WATCHDOG/3.
# v3.0.2 default is 2.5 — below ~2 it can false-trip on congested WiFi
# when a camera frame momentarily holds the socket.
WEBCTL_WATCHDOG=2.5
WEBCTL_POLL_WAIT=0.4

# ---- camera (all optional; driving never depends on it) -----------------
# auto = try ROS image topic -> cv2 device -> local MJPEG; degrades to none.
WEBCTL_CAM_MODE=auto
# ros mode (the WHEELTEC camera API — sensor_msgs/Image topics):
WEBCTL_CAM_ROS_TOPIC=/camera/image_raw      # empty = try the usual names
# cv2 mode (USB cam as /dev/video0, or a gstreamer pipeline for CSI cams):
WEBCTL_CAM_DEVICE=0
# mjpeg mode (only if web_video_server happens to be in the image —
# remember: we install nothing, so use ros/cv2 unless it's already there):
# WEBCTL_CAM_URL=http://127.0.0.1:8080/stream
WEBCTL_CAM_WIDTH=960
WEBCTL_CAM_FPS=15
WEBCTL_CAM_JPEG_Q=70
# (if no candidate topic ever delivers, the client auto-DISCOVERS any
#  sensor_msgs/Image topic on the graph — camera nodes started later, or
#  vendor-renamed topics, self-heal with no restart)

# ---- LiDAR (sensor_msgs/LaserScan -> small JSON at ~4 Hz) ----
# RPLidar A1: ros2 launch turn_on_wheeltec_robot wheeltec_lidar.launch.py
# (serial /dev/wheeltec_lidar). Unknown LaserScan topics are auto-discovered.
#WEBCTL_SCAN_MODE=auto            # auto|off (dry-run emits a synthetic ring)
#WEBCTL_SCAN_CANDIDATES=/scan,/scan_raw,/base_scan,/scan_filtered
#WEBCTL_SCAN_HZ=4                 # upload pacing (latest scan always wins)
#WEBCTL_SCAN_RAYS=180             # downsample; 0 = every raw ray (~1.5 KB)
#WEBCTL_SCAN_MAX_M=12             # farther rays / inf / nan -> 0 = no return

# ROS topics (defaults match the WHEELTEC ROS2 image; rclpy preinstalled)
WEBCTL_CMD_VEL_TOPIC=/cmd_vel
WEBCTL_BATTERY_TOPICS=/PowerVoltage,/power_voltage

# Integration tests only (no ROS on the test host):
# WEBCTL_DRY_RUN=1
# WEBCTL_SINK=/tmp/webctl-sink.json
