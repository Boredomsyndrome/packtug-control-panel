# Copy to .env and edit. These are read by backend/webctl/settings.py

# rosbridge WebSocket on the robot SBC (default port 9090)
ROBOT_WS_URL=ws://192.168.0.100:9090

# web_video_server on the robot SBC
CAMERA_BASE_URL=http://192.168.0.100:8080
CAMERA_TOPIC=/image_raw

# ROS topics (default covers both wheeltec image variants)
# Battery: leave empty to auto-try PowerVoltage then power_voltage; or set explicitly.
BATTERY_TOPIC=
CMD_VEL_TOPIC=/cmd_vel

# Safety clamps (m/s, rad/s). Remote driving must stay slow.
MAX_LIN=0.5
MAX_ROT=0.7

# If set, the whole site (API + page) requires HTTP Basic auth.
# ALWAYS set these before exposing via DuckDNS/Caddy/internet.
WEBCTL_AUTH_USER=
WEBCTL_AUTH_PASS=

# Django
DJANGO_SECRET_KEY=change-me-please
DJANGO_DEBUG=true
ALLOWED_HOSTS=*
