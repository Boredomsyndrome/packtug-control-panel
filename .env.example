# Copy to .env and edit. Read by backend/webctl/settings.py (SERVER side).
# Robot-side config lives in robotctl/robotctl.env.example instead.

# The fleet registry: robot_id:token pairs, comma-separated. The token is
# this robot's client secret (HTTP Basic password; username = robot id).
# Generate one per robot:  python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# An empty token ("myrobot:") disables robot auth — LAN-dev only!
WEBCTL_ROBOTS=s2000-1:change-me,s2000-2:change-me-too

# Safety clamps (m/s, rad/s). Remote driving must stay slow.
# Enforced twice: here at the command gate, and the robot client watchdog
# (WEBCTL_WATCHDOG) stops the robot if the link to THIS server dies.
MAX_LIN=0.5
MAX_ROT=0.7

# A held browser command older than this is replaced by ZERO at the next
# robot poll (browser stops driving -> robot stops within this window).
CMD_TIMEOUT=0.5

# Max accepted camera JPEG upload per frame (bytes).
MAX_FRAME=2097152

# If set, the whole BROWSER site (page + /api + /cam) requires HTTP Basic
# auth. Robots under /robotctl/ use their per-robot token instead.
# ALWAYS set this before exposing via DuckDNS/Caddy/internet.
WEBCTL_AUTH_USER=
WEBCTL_AUTH_PASS=

# Django
DJANGO_SECRET_KEY=change-me-please
DJANGO_DEBUG=true
ALLOWED_HOSTS=*
